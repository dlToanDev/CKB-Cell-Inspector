# CKB Cell Inspector - Environment Configuration Example
# Copy this file to .env.local to customize your configuration

# Default CKB JSON-RPC Node endpoint
# Testnet (Pudge): https://testnet.ckb.dev/rpc
# Mainnet (Mirana): https://mainnet.ckb.dev/rpc
# Local CKB Dev Node: http://127.0.0.1:8114
NEXT_PUBLIC_CKB_RPC_URL=https://testnet.ckb.dev/rpc

# Default active network identifier (testnet | mainnet | custom)
NEXT_PUBLIC_CKB_NETWORK=testnet
